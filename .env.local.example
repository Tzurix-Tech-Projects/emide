# Número do WhatsApp que recebe os pedidos (DDI + DDD + número, só dígitos).
# Exemplo: 5511998765432
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Lançamento inicial institucional. Ative somente após concluir o backlog da loja.
NEXT_PUBLIC_STORE_ENABLED=false

# Domínio público do site, usado em canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://emideinteligenciaolfativa.com

# Supabase: Project Settings > API, no painel do supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
